# CVIntelligenceService environment variables
# Copy file này thành .env và điền giá trị thực

MONGO_URL=mongodb://root:root@localhost:27017/?authSource=admin
MONGO_DB=CVIntelligenceDB
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
SBERT_MODEL=paraphrase-multilingual-mpnet-base-v2

# Local AI Settings
USE_LOCAL_AI=false
LOCAL_AI_URL=http://host.docker.internal:11434
LOCAL_AI_MODEL=gemma4:e2b

# Vertex AI Settings
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=YOUR_GCP_PROJECT_ID
VERTEX_LOCATION=us-central1
VERTEX_CREDENTIALS_JSON=

