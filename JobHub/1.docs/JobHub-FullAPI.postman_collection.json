{
  "info": {
    "_postman_id": "jobhub-full-collection-v2",
    "name": "JobHub - Full API Collection",
    "description": "Postman collection đầy đủ cho JobHub Microservices.\n\n📌 Ports:\n- AuthService:    http://localhost:5001\n- ProfileService: http://localhost:5002\n- ApiGateway:     http://localhost:5000\n\n🚀 Hướng dẫn:\n1. Chạy 'Login (Admin)' → accessToken tự lưu\n2. Chạy từng nhóm API cần test\n3. Các biến (skillId, customerId...) tự lưu qua test script\n\n⚠️ Lưu ý: Trong bộ API này tất cả request đã được chuyển qua cổng chung {{baseUrl}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:5000", "type": "string", "description": "API Gateway — tất cả request đều qua đây" },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "roleId",       "value": "", "type": "string" },
    { "key": "permissionId", "value": "", "type": "string" },
    { "key": "userId",       "value": "", "type": "string" },
    { "key": "customerId",   "value": "", "type": "string" },
    { "key": "skillId",      "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
              "    console.log('✅ accessToken saved');",
              "}",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has accessToken', () => pm.expect(res.data.accessToken).to.be.a('string'));"
            ]
          }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@jobhub.vn\",\n  \"password\": \"Admin@123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        },
